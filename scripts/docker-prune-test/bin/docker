#!/bin/sh
# stub dind: images "id ref" in $STATE/images, containers "id image state
# created-seconds" in $STATE/containers; what it changes goes to
# $STATE/calls, and image prune, which fails pulls under way, is no command
[ -e "$STATE/down" ] && { echo "Cannot connect to the Docker daemon" >&2; exit 1; }
now=$(cat "$STATE/now")
keep() { awk "$1" "$STATE/$2" > "$STATE/$2.t" && mv "$STATE/$2.t" "$STATE/$2"; }
case "$*" in
  "image ls -q --no-trunc") cut -d' ' -f1 "$STATE/images" ;;
  "ps -q --no-trunc") awk '$3 == "running" { print $1 }' "$STATE/containers" ;;
  "builder prune -af"|"builder prune -af --filter until="*|"network prune -f --filter until="*) echo "$*" >> "$STATE/calls" ;;
  "container prune -f --filter until="*)
    echo "$*" >> "$STATE/calls"
    u=${5#until=}; case $u in *h) s=$((${u%h} * 3600)) ;; *m) s=$((${u%m} * 60)) ;; *) exit 98 ;; esac
    keep "\$3 == \"running\" || \$4 > $((now - s))" containers ;;
  "image ls -q --no-trunc --filter dangling=true") awk '$2 == "<none>" { print $1 }' "$STATE/images" ;;
  "image rm "*)
    grep -q "^$3 " "$STATE/images" || { echo "No such image: $3" >&2; exit 1; }
    awk -v id="$3" '$2 == id { f = 1 } END { exit !f }' "$STATE/containers" && { echo "conflict: $3 is in use" >&2; exit 1; }
    echo "$*" >> "$STATE/calls"
    keep "\$1 != \"$3\"" images ;;
  *) echo "unexpected: docker $*" >> "$STATE/calls"; exit 99 ;;
esac
