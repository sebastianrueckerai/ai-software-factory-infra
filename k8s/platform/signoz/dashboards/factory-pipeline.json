{
  "schemaVersion": "v6",
  "image": "",
  "name": "factory-pipeline",
  "tags": [],
  "spec": {
    "display": {
      "name": "factory pipeline",
      "description": "CI, build VMs, rolls and task gates from factoryd's OTel metrics. Applied by the signoz-dashboard CronJob from the infra repository; edits in the UI are overwritten."
    },
    "variables": [],
    "panels": {
      "buildvm-cost": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Build VM cost per day (EUR)",
            "description": ""
          },
          "plugin": {
            "kind": "signoz/BarChartPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time",
                "fillSpans": false,
                "stackedBarChart": true
              },
              "formatting": {
                "unit": "EUR",
                "decimalPrecision": "2"
              },
              "axes": {
                "softMin": null,
                "softMax": null,
                "isLogScale": false
              },
              "legend": {
                "position": "bottom",
                "mode": "list",
                "customColors": null
              },
              "thresholds": []
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "plugin": {
                  "kind": "signoz/CompositeQuery",
                  "spec": {
                    "queries": [
                      {
                        "type": "builder_query",
                        "spec": {
                          "name": "A",
                          "stepInterval": 86400,
                          "signal": "metrics",
                          "source": "",
                          "aggregations": [
                            {
                              "metricName": "factory.ci.buildvm.cost",
                              "temporality": "",
                              "timeAggregation": "increase",
                              "spaceAggregation": "sum"
                            }
                          ],
                          "disabled": false,
                          "groupBy": [
                            {
                              "name": "deleted_by",
                              "signal": "",
                              "fieldContext": "attribute",
                              "fieldDataType": "string"
                            }
                          ],
                          "legend": "{{deleted_by}}"
                        }
                      }
                    ]
                  }
                }
              }
            }
          ],
          "links": []
        }
      },
      "buildvm-time": {
