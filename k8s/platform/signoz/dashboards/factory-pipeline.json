                      {
                        "type": "builder_query",
                        "spec": {
                          "name": "C",
                          "signal": "metrics",
                          "source": "",
                          "aggregations": [
                            {
                              "metricName": "factory.ci.buildvm.ready",
                              "temporality": "",
                              "timeAggregation": "",
                              "spaceAggregation": "p50"
                            }
                          ],
                          "disabled": false,
                          "legend": "ready p50"
                        }
                      },
                      {
                        "type": "builder_query",
                        "spec": {
                          "name": "D",
                          "signal": "metrics",
                          "source": "",
                          "aggregations": [
                            {
                              "metricName": "factory.ci.buildvm.ready",
