      "buildvm-cost": {
        "kind": "Panel",
        "spec": {
          "display": {
            "description": "",
            "name": "Build VM cost per day (EUR)"
          },
          "links": [],
          "plugin": {
            "kind": "signoz/BarChartPanel",
            "spec": {
              "axes": {
                "isLogScale": false,
                "softMax": null,
                "softMin": null
              },
              "formatting": {
                "decimalPrecision": "2",
                "unit": "EUR"
              },
              "legend": {
                "customColors": null,
                "mode": "list",
                "position": "bottom"
              },
              "thresholds": [],
              "visualization": {
                "fillSpans": false,
                "stackedBarChart": true,
                "timePreference": "global_time"
              }
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "plugin": {
                  "kind": "signoz/CompositeQuery",
                  "spec": {
                    "queries": [
                      {
                        "spec": {
                          "aggregations": [
                            {
                              "metricName": "factory.ci.buildvm.cost",
                              "reduceTo": "",
                              "spaceAggregation": "sum",
                              "temporality": "",
                              "timeAggregation": "increase"
                            }
                          ],
                          "disabled": false,
                          "functions": null,
                          "groupBy": [
                            {
                              "fieldContext": "attribute",
                              "fieldDataType": "string",
                              "name": "deleted_by",
                              "signal": ""
                            }
                          ],
                          "legend": "{{deleted_by}}",
                          "name": "A",
                          "order": null,
                          "secondaryAggregations": null,
                          "selectFields": null,
                          "signal": "metrics",
                          "source": "",
                          "stepInterval": 86400
                        },
                        "type": "builder_query"
                      }
                    ]
                  }
                }
              }
            }
          ]
        }
      },
