{
  "alert": "Node disk above 80 %",
  "alertType": "METRIC_BASED_ALERT",
  "annotations": {
    "summary": "used share of the node's EPHEMERAL filesystem, in %",
    "value": "{{$value}}"
  },
  "condition": {
    "compositeQuery": {
      "panelType": "graph",
      "queries": [
        {
          "spec": {
            "aggregations": [
              {
                "metricName": "k8s.node.filesystem.available",
                "spaceAggregation": "min",
                "temporality": "",
                "timeAggregation": "latest"
              }
            ],
            "disabled": false,
            "groupBy": [
              {
                "fieldContext": "resource",
                "fieldDataType": "string",
                "name": "k8s.node.name",
                "signal": ""
              }
            ],
            "legend": "",
            "name": "A",
            "signal": "metrics",
            "source": "",
            "stepInterval": 60
          },
          "type": "builder_query"
        },
        {
          "spec": {
            "aggregations": [
              {
                "metricName": "k8s.node.filesystem.capacity",
                "spaceAggregation": "max",
                "temporality": "",
                "timeAggregation": "latest"
              }
            ],
            "disabled": false,
            "groupBy": [
              {
                "fieldContext": "resource",
                "fieldDataType": "string",
                "name": "k8s.node.name",
                "signal": ""
              }
            ],
            "legend": "",
            "name": "B",
            "signal": "metrics",
            "source": "",
            "stepInterval": 60
          },
          "type": "builder_query"
        },
        {
          "spec": {
            "disabled": false,
            "expression": "(B - A) * 100 / B",
            "legend": "",
            "name": "F1"
          },
          "type": "builder_formula"
        }
      ],
      "queryType": "builder"
    },
    "selectedQueryName": "F1",
    "thresholds": {
      "kind": "basic",
      "spec": [
        {
          "channels": [
            "factoryd"
          ],
          "matchType": "3",
          "name": "critical",
          "op": "1",
          "recoveryTarget": null,
          "target": 80,
          "targetUnit": ""
        }
      ]
    }
  },
  "description": "A node's EPHEMERAL filesystem (/var: the images, the pods' writable layers and emptyDirs, the factory caches) was more than 80 % full on average over the last 5 minutes, per node (kubeletstats k8s.node.filesystem.*, the kubelet's node filesystem). The images lie on it too, so the kubelet's imagefs.available<15 % is its DiskPressure line: at 85 % it evicts pods. Its image garbage collection starts at 75 % (talos/patches.yaml).",
  "disabled": false,
  "evaluation": {
    "kind": "rolling",
    "spec": {
      "evalWindow": "5m",
      "frequency": "1m"
    }
  },
  "labels": {
    "namespace": "platform",
    "severity": "critical"
  },
  "notificationSettings": {
    "usePolicy": false
  },
  "ruleType": "threshold_rule",
  "schemaVersion": "v2alpha1",
  "version": "v5"
}
