{
  "alert": "Chain poller stopped",
  "alertType": "METRIC_BASED_ALERT",
  "annotations": {
    "summary": "seconds since the chain poller's last successful tick of a repository",
    "value": "{{$value}}"
  },
  "condition": {
    "compositeQuery": {
      "panelType": "graph",
      "queries": [
        {
          "spec": {
            "aggregations": [
              {
                "metricName": "factory.chain.poll_age",
                "spaceAggregation": "max",
                "temporality": "",
                "timeAggregation": "latest"
              }
            ],
            "disabled": false,
            "filter": {
              "expression": ""
            },
            "groupBy": [
              {
                "fieldContext": "attribute",
                "fieldDataType": "string",
                "name": "repository",
                "signal": ""
              }
            ],
            "legend": "",
            "name": "A",
            "signal": "metrics",
            "source": "",
            "stepInterval": 60
          },
          "type": "builder_query"
        }
      ],
      "queryType": "builder"
    },
    "selectedQueryName": "A",
    "thresholds": {
      "kind": "basic",
      "spec": [
        {
          "channels": [
            "factoryd"
          ],
          "matchType": "1",
          "name": "critical",
          "op": "1",
          "recoveryTarget": null,
          "target": 60,
          "targetUnit": ""
        }
      ]
    }
  },
  "description": "The chain poller's last successful tick of a repository was more than 60 seconds ago (factory.chain.poll_age, computed by factoryd at each metric export, every 30 s). The poller ticks every 15 s, so 60 s is three ticks rounded up to the next export: a poller that stopped while factoryd lives, or a repository whose tick keeps failing, records no chain, ends no merged card and raises no red or stall.",
  "disabled": false,
  "evaluation": {
    "kind": "rolling",
    "spec": {
      "evalWindow": "2m",
      "frequency": "1m"
    }
  },
  "labels": {
    "namespace": "platform",
    "severity": "critical"
  },
  "notificationSettings": {
    "usePolicy": false
  },
  "ruleType": "threshold_rule",
  "schemaVersion": "v2alpha1",
  "version": "v5"
}
