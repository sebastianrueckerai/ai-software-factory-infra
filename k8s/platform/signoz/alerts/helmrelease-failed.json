{
  "alert": "HelmRelease failed or went back",
  "alertType": "LOGS_BASED_ALERT",
  "condition": {
    "compositeQuery": {
      "panelType": "graph",
      "queries": [
        {
          "spec": {
            "aggregations": [
              {
                "expression": "count()"
              }
            ],
            "disabled": false,
            "filter": {
              "expression": "attribute.k8s.event.reason IN ('InstallFailed', 'UpgradeFailed', 'RollbackFailed', 'RollbackSucceeded', 'UninstallFailed') AND resource.k8s.object.kind = 'HelmRelease'"
            },
            "groupBy": [
              {
                "fieldContext": "attribute",
                "fieldDataType": "string",
                "name": "k8s.namespace.name",
                "signal": ""
              },
              {
                "fieldContext": "resource",
                "fieldDataType": "string",
                "name": "k8s.object.name",
                "signal": ""
              }
            ],
            "legend": "",
            "name": "A",
            "signal": "logs",
            "source": "",
            "stepInterval": 60
          },
          "type": "builder_query"
        }
      ],
      "queryType": "builder"
    },
    "selectedQueryName": "A",
    "thresholds": {
      "kind": "basic",
      "spec": [
        {
          "channels": [],
          "matchType": "1",
          "name": "warning",
          "op": "1",
          "recoveryTarget": null,
          "target": 0,
          "targetUnit": ""
        }
      ]
    }
  },
  "description": "A Flux HelmRelease failed or went back within the last 15 minutes: the helm-controller's Warning event InstallFailed, UpgradeFailed, RollbackFailed or UninstallFailed, or its Normal event RollbackSucceeded, which says the release went back to the one before. It clears by itself 15 minutes after the last such event, whether or not the HelmRelease is Ready again. The label event marks the failure as an event: factoryd closes no card when the alert clears.",
  "disabled": false,
  "evaluation": {
    "kind": "rolling",
    "spec": {
      "evalWindow": "15m",
      "frequency": "1m"
    }
  },
  "labels": {
    "event": "true",
    "severity": "warning"
  },
  "notificationSettings": {
    "usePolicy": true
  },
  "ruleType": "threshold_rule",
  "schemaVersion": "v2alpha1",
  "version": "v5"
}
