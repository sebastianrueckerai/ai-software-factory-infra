{
  "alert": "Job has a failed pod",
  "alertType": "METRIC_BASED_ALERT",
  "condition": {
    "compositeQuery": {
      "panelType": "graph",
      "queries": [
        {
          "spec": {
            "aggregations": [
              {
                "metricName": "k8s.job.failed_pods",
                "spaceAggregation": "max",
                "temporality": "",
                "timeAggregation": "max"
              }
            ],
            "disabled": false,
            "groupBy": [
              {
                "fieldContext": "",
                "fieldDataType": "",
                "name": "k8s.namespace.name",
                "signal": ""
              },
              {
                "fieldContext": "",
                "fieldDataType": "",
                "name": "k8s.job.name",
                "signal": ""
              }
            ],
            "legend": "",
            "name": "A",
            "signal": "metrics",
            "source": "",
            "stepInterval": 60
          },
          "type": "builder_query"
        }
      ],
      "queryType": "builder"
    },
    "selectedQueryName": "A",
    "thresholds": {
      "kind": "basic",
      "spec": [
        {
          "channels": [],
          "matchType": "1",
          "name": "warning",
          "op": "1",
          "recoveryTarget": null,
          "target": 0,
          "targetUnit": ""
        }
      ]
    }
  },
  "description": "A Kubernetes Job, a CronJob run included, has had a failed pod within the last 15 minutes. It clears 15 minutes after the failed Job is deleted.",
  "disabled": false,
  "evaluation": {
    "kind": "rolling",
    "spec": {
      "evalWindow": "15m",
      "frequency": "1m"
    }
  },
  "labels": {
    "severity": "warning"
  },
  "notificationSettings": {
    "usePolicy": false
  },
  "ruleType": "threshold_rule",
  "schemaVersion": "v2alpha1",
  "version": "v5"
}
