{
  "alert": "Job failed",
  "alertType": "LOGS_BASED_ALERT",
  "condition": {
    "compositeQuery": {
      "panelType": "graph",
      "queries": [
        {
          "spec": {
            "aggregations": [
              {
                "expression": "count()"
              }
            ],
            "disabled": false,
            "filter": {
              "expression": "attribute.k8s.event.reason IN ('BackoffLimitExceeded', 'DeadlineExceeded') AND resource.k8s.object.kind = 'Job'"
            },
            "groupBy": [
              {
                "fieldContext": "attribute",
                "fieldDataType": "string",
                "name": "k8s.namespace.name",
                "signal": ""
              },
              {
                "fieldContext": "resource",
                "fieldDataType": "string",
                "name": "k8s.object.name",
                "signal": ""
              }
            ],
            "legend": "",
            "name": "A",
            "signal": "logs",
            "source": "",
            "stepInterval": 60
          },
          "type": "builder_query"
        }
      ],
      "queryType": "builder"
    },
    "selectedQueryName": "A",
    "thresholds": {
      "kind": "basic",
      "spec": [
        {
          "channels": [],
          "matchType": "1",
          "name": "warning",
          "op": "1",
          "recoveryTarget": null,
          "target": 0,
          "targetUnit": ""
        }
      ]
    }
  },
  "description": "A Kubernetes Job, a CronJob run included, failed within the last 15 minutes: the Job controller's Warning event BackoffLimitExceeded or DeadlineExceeded. It clears by itself 15 minutes after the failure, whether or not the failed Job is deleted.",
  "disabled": false,
  "evaluation": {
    "kind": "rolling",
    "spec": {
      "evalWindow": "15m",
      "frequency": "1m"
    }
  },
  "labels": {
    "severity": "warning"
  },
  "notificationSettings": {
    "usePolicy": true
  },
  "ruleType": "threshold_rule",
  "schemaVersion": "v2alpha1",
  "version": "v5"
}
